supabase/snippets/

# Keys that must never be committed
*.pem
*.key

# Spike B — canned audio clips, replica training source footage, and recording
# outputs. Large media, provider-identifying content. Shared via Supabase
# Storage signed URLs (bucket `spike-b-clips`, 12h TTL), not git.
artifacts/spike-b/

# Spike output / test artifacts. Local-only.
.spike-output/

# Local Phase 0 face-upload verifier inputs. scripts/face-phase0-verify.mjs
# reads an image path; admins typically save trial photos at the repo root.
# Keep them out of git (some are PII — actual creator face photos).
/face-test*.png
/face-test*.jpg
/face-test*.jpeg

# Diagnostic spike logs (transient, not source)
/spike-run.log
/spike-*.log

# Private creator content used for v3 segmentation dry-run
scripts/aod_test_corpus/

# Throwaway scratch dir for one-off scripts / temp test fixtures
tmp/
