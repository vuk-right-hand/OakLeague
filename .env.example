# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin / automation (rotate separately — leaking one must not compromise the other)
ADMIN_SECRET=
PIPELINE_SECRET=

# Voice — Gemini Live
# Primary: pinned 3.1 preview per 2026-04-20 decision. Spike A on Day 4 must re-verify real-device PWA latency.
# Fallback: `gemini-live-2.5-flash-native-audio` (GA). Swap env var only, no code change required.
VOICE_MODEL=gemini-3.1-flash-live-preview
GEMINI_API_KEY=

# Voice — TTS
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Avatar — pending Day 5 spike (Simli vs Tavus)
SIMLI_API_KEY=
SIMLI_FACE_ID=
TAVUS_API_KEY=

# Realtime transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Video CDN
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
NEXT_PUBLIC_MUX_ENV_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Feature flags
NEXT_PUBLIC_AUDIO_PREWARM=true
