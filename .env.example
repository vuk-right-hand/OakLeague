# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin / automation (rotate separately — leaking one must not compromise the other)
ADMIN_SECRET=
# Vercel Cron auth secret (>= 32 chars). Vercel auto-sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Voice — Gemini Live
# Spike A gate cleared 2026-04-21: 3.1 is primary (p50 2.5-3.4s, ~2× faster than 2.5 across
# desktop Chrome / Pixel 7 Pro WiFi+LTE / iPhone 11 WiFi+LTE). 2.5 retained as env-swap
# fallback in case Google deprecates the 3.1 preview mid-demo. Both on v1alpha.
# To fall back: swap PRIMARY to the 2.5 ID, redeploy Vercel + Fly (~2 min).
VOICE_MODEL_PRIMARY=gemini-3.1-flash-live-preview
VOICE_MODEL_SECONDARY=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_API_KEY=

# Voice proxy (Fly.io). Public WSS URL the PWA opens with ?ticket=<uuid>.
# Must be wss:// (TLS) in production. Dev can use ws:// to a local proxy.
# The ticket query param is scrubbed by Sentry (see sentry.{client,server}.config.ts).
NEXT_PUBLIC_VOICE_PROXY_URL=wss://oakleague-voice-proxy.fly.dev/voice/spike-a

# Voice — TTS
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Avatar — Spike B (SPIKE_B_PLAN.md Rev 5): tier-routed provider-agnostic architecture.
# Both providers ship. Tier routing at session-open from sessions.tier_at_session —
# no mid-session hot-swap, no error-driven cross-tier fallback (silent swap would
# create unconsented cost events: $0.01/min free user → $0.37/min Tavus pipe).
#   free      → Simli Trinity-1   (~$0.01–0.015/min)
#   premium   → Tavus Phoenix-4   (~$0.32–0.37/min; sub-600ms, full-duplex, active listening)
#   boardroom → Tavus Phoenix-4
SIMLI_API_KEY=
SIMLI_REPLICA_ID=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
AVATAR_PROVIDER_FREE=simli
AVATAR_PROVIDER_PREMIUM=tavus
AVATAR_PROVIDER_BOARDROOM=tavus

# Spike B kill-switch: hard cap + run-count backstop + pre-run estimate with
# ceiling rates. `SIMLI_CEILING` conservative until written quote from Simli
# support lands (Trinity-tier @ 100K min/mo commit). See SPIKE_B_PLAN.md §Kill-switch.
SPIKE_B_HARD_CAP_DOLLARS=25
SPIKE_B_MAX_RUNS_PER_DAY=300
SIMLI_CEILING_USD_PER_MIN=0.05
TAVUS_CEILING_USD_PER_MIN=0.50

# Realtime transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Video CDN
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
NEXT_PUBLIC_MUX_ENV_KEY=

# Feed kill switch. '1' = root renders the vertical feed. Anything else
# (or unset) redirects root to /waitlist. Flip in Vercel env vars to
# revert demo-day without a redeploy. (Feed plan R3-M8.)
NEXT_PUBLIC_FEED_ENABLED=0

# React/Duet capture rollout flag. '1' = on (MuxVideo mounts gain
# crossOrigin="anonymous" required for canvas drawImage during capture,
# AND ReactButton/duet UI mounts). Anything else (or unset) = off,
# Mux HLS playback unchanged. Ships 24h before any React feature code
# so a regression on the existing playback path is independently
# revertable from feature work via env flip + redeploy. See
# REACT_DUET_PLAN.md §20.4 + §23.9.
#
# IMPORTANT — flip semantics differ from NEXT_PUBLIC_FEED_ENABLED:
# this flag is consumed in CLIENT components (hook-panel, long-form-player),
# and Next.js inlines NEXT_PUBLIC_* references into client bundles at
# BUILD TIME. Flipping in Vercel takes effect only on next deploy.
# To revert a soak-time regression mid-window, use Vercel's instant
# rollback to the prior deployment, OR set the var and redeploy.
NEXT_PUBLIC_REACT_CAPTURE_ENABLED=0

# Reserved for v2 signed playback (tier-gated):
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Waitlist captcha (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Invite tokens — 256-bit random secrets.
# _NEXT supports rotation. Overlap window must be >= max invite lifetime (7d).
INVITE_TOKEN_HMAC_SECRET_CURRENT=
INVITE_TOKEN_HMAC_SECRET_NEXT=

