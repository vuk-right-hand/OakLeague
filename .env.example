# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin / automation (rotate separately — leaking one must not compromise the other)
ADMIN_SECRET=
# Vercel Cron auth secret (>= 32 chars). Vercel auto-sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Voice — Gemini Live
# Spike A gate cleared 2026-04-21: 3.1 is primary (p50 2.5-3.4s, ~2× faster than 2.5 across
# desktop Chrome / Pixel 7 Pro WiFi+LTE / iPhone 11 WiFi+LTE). 2.5 retained as env-swap
# fallback in case Google deprecates the 3.1 preview mid-demo. Both on v1alpha.
# To fall back: swap PRIMARY to the 2.5 ID, redeploy Vercel + Fly (~2 min).
VOICE_MODEL_PRIMARY=gemini-3.1-flash-live-preview
VOICE_MODEL_SECONDARY=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_API_KEY=

# Voice proxy (Fly.io). Public WSS URL the PWA opens with ?ticket=<uuid>.
# Must be wss:// (TLS) in production. Dev can use ws:// to a local proxy.
# The ticket query param is scrubbed by Sentry (see sentry.{client,server}.config.ts).
NEXT_PUBLIC_VOICE_PROXY_URL=wss://oakleague-voice-proxy.fly.dev/voice/spike-a

# Voice — TTS
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Avatar — Spike B (SPIKE_B_PLAN.md Rev 5): tier-routed provider-agnostic architecture.
# Both providers ship. Tier routing at session-open from sessions.tier_at_session —
# no mid-session hot-swap, no error-driven cross-tier fallback (silent swap would
# create unconsented cost events: $0.01/min free user → $0.37/min Tavus pipe).
#   free      → Simli Trinity-1   (~$0.01/min Hobby; estimate $0.011 incl. buffer)
#   premium   → Tavus Phoenix-4   (~$0.32–0.37/min; sub-600ms, full-duplex, active listening)
#   boardroom → Tavus Phoenix-4
SIMLI_API_KEY=
SIMLI_REPLICA_ID=

# Voice + face clone rate-limit bypass (comma-separated admin user-ids).
# Use ONLY during a Cartesia/Simli outage when an admin has legitimately
# burned through the 24h cap. Audit rows still write — every clone /
# train remains visible. Process: flip env, redeploy, do work, unset env,
# redeploy. Never leave set permanently. CREATOR_CLONE_RATE_LIMIT_BYPASS
# is the going-forward name (covers voice + face); the old
# VOICE_CLONE_RATE_LIMIT_BYPASS is read in union for one alias cycle.
CREATOR_CLONE_RATE_LIMIT_BYPASS=
VOICE_CLONE_RATE_LIMIT_BYPASS=

# Face-upload local-test bypass. Allows /api/admin/face-upload to run
# against real Simli when VERCEL_ENV is unset (local `next dev` / `next
# start`). Burns a real face slot on the configured Simli account.
# Set ONLY in `.env.local` while testing; never in CI / preview /
# production. Auditor R2-C5: gate is otherwise fail-closed against
# missing VERCEL_ENV (custom Docker, CI runs, etc.).
FACE_UPLOAD_ALLOW_LOCAL=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=

# HeyGen LiveAvatar Lite (PHASE_0_HEYGEN.md §1, §11). API key from
# app.liveavatar.com → Space Settings → API. Free tier = 10 credits/month
# (Lite = 1 credit/min ≈ 10 minutes of avatar). Privileged token; never
# commit to git.
LIVEAVATAR_API_KEY=
# Per-session max length seconds. Default 300 (5 min) keeps a single
# runaway from burning ~7 of the monthly 10 free-tier credits. HeyGen's
# server cap is 1200 (20 min) but we clamp tighter (audit-r2 S1).
LIVEAVATAR_MAX_SESSION_S=300
# Voice-proxy keep-alive cadence to HeyGen REST /v1/sessions/keep-alive.
# Default 30000 (30s). HeyGen drops the control WS at ~120s of silence
# (PHASE_0_HEYGEN.md §9), so anything over ~90s is unsafe. Server-side
# only — set as a Fly secret on oakleague-voice-proxy.
LIVEAVATAR_HEARTBEAT_MS=30000

# Avatar provider routing per tier. Each tier locks at session-open;
# never swaps mid-session (CLAUDE.md §Provider-Agnostic). Allowed values:
# simli | tavus | heygen | none (none = voice-only).
# Tavus scrapped post-Spike-B; left in env for backward-compat envs that
# still set it — resolver coerces to null in prod if not in ALLOWED.
AVATAR_PROVIDER_FREE=simli
AVATAR_PROVIDER_PREMIUM=simli
AVATAR_PROVIDER_BOARDROOM=simli

# Spike B kill-switch: hard cap + run-count backstop + pre-run estimate with
# ceiling rates. `SIMLI_CEILING` conservative until written quote from Simli
# support lands (Trinity-tier @ 100K min/mo commit). See SPIKE_B_PLAN.md §Kill-switch.
# `HEYGEN_CEILING` = 2× published $0.10/min Lite per Phase 0 §14.
SPIKE_B_HARD_CAP_DOLLARS=25
SPIKE_B_MAX_RUNS_PER_DAY=300
SIMLI_CEILING_USD_PER_MIN=0.05
TAVUS_CEILING_USD_PER_MIN=0.50
HEYGEN_CEILING_USD_PER_MIN=0.20

# Realtime transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Video CDN
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
NEXT_PUBLIC_MUX_ENV_KEY=

# Feed kill switch. '1' = root renders the vertical feed. Anything else
# (or unset) redirects root to /waitlist. Flip in Vercel env vars to
# revert demo-day without a redeploy. (Feed plan R3-M8.)
NEXT_PUBLIC_FEED_ENABLED=0

# Reserved for v2 signed playback (tier-gated):
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Waitlist captcha (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Invite tokens — 256-bit random secrets.
# _NEXT supports rotation. Overlap window must be >= max invite lifetime (7d).
INVITE_TOKEN_HMAC_SECRET_CURRENT=
INVITE_TOKEN_HMAC_SECRET_NEXT=


# ─────────────────────────────────────────────────────────────────────────
# RAG SOTA Phase 2 — retrieval orchestrator (Days 8-12)
# ─────────────────────────────────────────────────────────────────────────

# Voyage rerank-2.5 (primary; Cohere fallback deferred until scale)
VOYAGE_API_KEY=
RERANK_PROVIDER=voyage
# Optional overrides for swap-readiness:
# VOYAGE_RERANK_MODEL=rerank-2.5
# VOYAGE_RERANK_USD_PER_INPUT_TOKEN=0.00000005
# VOYAGE_RERANK_QUOTED_AT=2026-05-14
# VOYAGE_RERANK_RPS_BUCKET=25
# VOYAGE_RERANK_QUEUE_TOLERANCE_MS=200

# Gemini Flash query rewriter (Day-9)
# QUERY_REWRITE_MODEL=gemini-2.5-flash
# QUERY_REWRITE_USD_PER_INPUT_TOKEN=0.0000003
# QUERY_REWRITE_USD_PER_OUTPUT_TOKEN=0.0000025
# QUERY_REWRITE_QUOTED_AT=2026-05-14

# Gemini embedding (Day-9)
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_USD_PER_TOKEN=0.00000015
# EMBEDDING_QUOTED_AT=2026-05-14

# Per-turn budget for the retrieval orchestrator. Caller passes
# Date.now() + RAG_TURN_BUDGET_MS as deadlineMs; every DB/embed/rerank
# call races against it. NOTE: on the DECOUPLED path the proxy OVERRIDES this
# with DECOUPLED_RETRIEVE_BUDGET_MS (below), so this default only governs the
# legacy/v1 callers and tests.
# RAG_TURN_BUDGET_MS=4000

# Decoupled retrieval headroom (2026-05-23). The proxy (Fly) sends budget_ms to
# the shim and waits up to the ceiling for the result. INVARIANT enforced at
# proxy boot: CEILING ≥ BUDGET + 500 (shim client HTTP grace). The query-rewrite
# cap (Vercel) MUST stay ≤ BUDGET minus ~1100ms (embed+topk+rerank), else slow
# rewrites starve the rest → 504 → persona-only. These live in TWO deploy units
# (BUDGET/CEILING on Fly, rewrite cap on Vercel) — change them as a coordinated
# pair and deploy Vercel before/with Fly.
# DECOUPLED_RETRIEVE_BUDGET_MS=3500     # Fly (proxy) — shim self-cancel budget
# DECOUPLED_RETRIEVE_CEILING_MS=4000    # Fly (proxy) — orchestrator patience
# QUERY_REWRITE_TIMEOUT_MS=2200         # Vercel (Next) — rewrite hard cap, ≤3000

# Decoupled deep-answer depth. Unset/anything-but-'variable' = BRIEF (1-3
# sentences). 'variable' = match depth to the question (tell stories fully;
# free ~150 words, paid ~450). Instant A/B rollback = unset.
# BRAIN_DEPTH_MODE=variable

# P0-3 — ungrounded-answer behavior on the decoupled deep path (Fly proxy).
# When a v3 retrieval comes back EMPTY the deep answer hedges instead of
# fabricating: a clean-empty result = "off-domain", a timeout/error = "retrieval
# failure". OFF_DOMAIN_HEDGE_ENABLED gates the "outside my experience" copy:
# strict '1' = on. min_sim is CALIBRATED (2026-06-01 aod sweep: floor has no
# recall effect in [0,0.3]; off-topic empty at floor 0), so off-domain detection
# is trustworthy and this is safe to flip. Left UNSET by default pending the live
# human voice test; while unset, off-domain uses the gentler "give me a concrete
# example" copy.
# V3_OFF_DOMAIN_HEDGE_ENABLED=1   # Fly (proxy) — enables the "outside my experience" hedge

# P0-3 / min_sim — per-rank-mode child-similarity floors for v3 retrieval (Vercel
# Next, src/lib/voice/v3-min-sim.ts). Each must be a finite number in (0, 1];
# anything else is rejected and falls back to the placeholder (logged). PIN these
# from the §7 harness sweep (scripts/diag-eval-v3.mjs) BEFORE flipping any creator
# to v3. Only max_blend is prod-frozen today; set the others if a sweep switches
# rank_mode. Absent = placeholder (max/max_blend/best_child 0.20, vec_max 0.40).
# V3_MIN_SIM_MAX=
# V3_MIN_SIM_MAX_BLEND=
# V3_MIN_SIM_VEC_MAX=
# V3_MIN_SIM_BEST_CHILD=

# Real-API integration test (Day-12). Off by default.
# RUN_REAL_API_TESTS=0
# RAG_TEST_CREATOR_ID=
